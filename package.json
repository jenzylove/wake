{
  "name": "wake-causal-market-response",
  "version": "0.3.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/run-framework.mjs dev",
    "build": "node --env-file-if-exists=.env.local scripts/run-framework.mjs build",
    "start": "node --env-file-if-exists=.env.local --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "data:capture": "node --env-file-if-exists=.env.local scripts/capture-real-incident.mjs",
    "data:verify": "node scripts/verify-capture.mjs",
    "discover": "node --env-file-if-exists=.env.local scripts/discover-incidents.mjs",
    "watch:chain": "node --env-file-if-exists=.env.local scripts/watch-chain.mjs",
    "blind:run": "node blind/run.mjs",
    "demo": "node --env-file-if-exists=.env.local scripts/demo.mjs",
    "blind:build": "cd blind && forge build",
    "agent:tick": "node --env-file-if-exists=.env.local scripts/wake-agent.mjs",
    "bitget:verify": "node --env-file-if-exists=.env.local scripts/verify-bitget-demo.mjs",
    "paper:tick": "node --env-file-if-exists=.env.local scripts/paper-tick.mjs",
    "paper:calibrate": "node scripts/paper/calibrate.mjs",
    "dev:shot": "node scripts/dev/screenshot.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@types/three": "^0.186.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.63.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "viem": "^2.56.8",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
