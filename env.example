# WAKE defaults to safe local paper mode.
WAKE_EXECUTION_MODE=paper
# Required for server-side mutations on a hosted deployment.
WAKE_OPERATOR_SECRET=
# Hard cap for each opening order sent to Bitget Demo Trading.
WAKE_MAX_DEMO_NOTIONAL_USDT=100

# Bitget Demo Trading only. Never commit real values.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Optional Cloudflare edge IP fallback for networks that cannot resolve api.bitget.com.
BITGET_API_IP=

# Use one of these for real chain evidence capture.
# A provider RPC is preferred for receipt reads; Etherscan V2 is the fallback.
CHAIN_RPC_URL=
ETHERSCAN_API_KEY=

# Optional server-side interpretation layer. Never expose this to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Keep disabled unless you intentionally want anonymous visitors to spend investigator tokens.
WAKE_PUBLIC_INVESTIGATOR=0

# Optional local append-only runtime store. Hosted Vercel storage needs a durable provider.
WAKE_RUNTIME_DIR=data/runtime
# For hosted Vercel durability, connect a private Blob store and set this token.
BLOB_READ_WRITE_TOKEN=
# Required for the scheduled watcher endpoint on a hosted deployment.
WAKE_SCHEDULER_SECRET=
